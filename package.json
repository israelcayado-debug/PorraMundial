{
  "name": "delfinporra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DelfinPorra: porra visual del Mundial 2026 para Delfin Tubes",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"vite --host 0.0.0.0 --config client/vite.config.js\"",
    "start": "node server/index.js",
    "build": "vite build --config client/vite.config.js",
    "email:daily": "node server/sendDailyDigest.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.511.0",
    "nodemailer": "^8.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.6.2",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  }
}
